# Сервер с панелью (FASTPANEL, ISPmanager и т. п.): HTTPS и домен обслуживает nginx панели,
# ilpacco слушает только 127.0.0.1:8080, панель проксирует на него ilpacco.ru.
# Скопируйте в server.env и задайте пароли (deploy-server.sh делает это сам).
PUBLIC_URL=https://ilpacco.ru
SITE_ADDRESS=:80
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
MAILPIT_PORT=8026
DB_HOST_PORT=15432
REDIS_HOST_PORT=16379

DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
REGISTRY=ghcr.io/lisiks-dot
TAG=latest
RUB_PER_EUR=113.3
VAT_ENABLED=false

# Почта и СМС — см. .env.example
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# SMS_RU_API_ID=
