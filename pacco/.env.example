# Адрес сайта, как его видят покупатели (без слеша в конце).
PUBLIC_URL=https://ilpacco.ru
# Домен для Caddy: с доменом включается HTTPS. Для локального запуска: SITE_ADDRESS=:80 и PUBLIC_URL=http://localhost
SITE_ADDRESS=ilpacco.ru

# Пароли — замените перед первым запуском.
DB_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me

# Образы из GitHub Container Registry (собирает CI). Без доступа к GHCR: docker compose up -d --build
REGISTRY=ghcr.io/lisiks-dot
TAG=latest

# Курс ЦБ (пока задаётся вручную) и сценарий НДС 22 % на зарубежные посылки.
RUB_PER_EUR=113.3
VAT_ENABLED=false

# Почта для уведомлений покупателям. По умолчанию письма ловит Mailpit (http://127.0.0.1:8025 на сервере).
# MAIL_HOST=smtp.example.ru
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=ilpacco.ru <no-reply@ilpacco.ru>

# СМС через SMS.ru: ключ api_id из личного кабинета SMS.ru. Без него СМС только пишутся в журнал.
# SMS_RU_API_ID=
# SMS_SENDER=ilpacco
