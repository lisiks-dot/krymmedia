# Локальный запуск на этом компьютере: сайт — http://127.0.0.1:8025
# Использование: ./start-local.sh  (или start-local.ps1 в Windows)
PUBLIC_URL=http://127.0.0.1:8025
SITE_ADDRESS=:80
HTTP_PORT=8025
HTTPS_PORT=8443
# Mailpit (письма покупателям) переезжает на 8026, чтобы освободить 8025 для сайта
MAILPIT_PORT=8026
# Порты баз на этом компьютере — сдвинуты, чтобы не мешать установленным PostgreSQL и Redis
DB_HOST_PORT=15432
REDIS_HOST_PORT=16379

DB_PASSWORD=pacco-local
KEYCLOAK_ADMIN_PASSWORD=change-me-now
REGISTRY=ghcr.io/lisiks-dot
TAG=latest
RUB_PER_EUR=113.3
VAT_ENABLED=false
